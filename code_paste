function compactFragments(fragmentsArray) {
  let fixedArray = []
  for (let i of fragmentsArray) {
    if (i === undefined) {
      console.log(`[COMPACTED]`)
    } else {
      fixedArray.push(i)
    }
  }
  return fixedArray
}

let compactedShuffledFragments = compactFragments(shuffledFragments)

function sortFragments(compactedArray) {
  let sortedArray = []
  for (let x of compactedArray) {
    sortedArray.push(x)
  }
  for (let i = 0; i < sortedArray.length; i++) {
    for (let j = 0; j < sortedArray.length-1; j++) {
      if (sortedArray[j]['id'] > sortedArray[j+1]['id']) {
        sortedArray[j] = sortedArray.splice(j+1, 1,sortedArray[j])[0]
      }
    }
  }
  return sortedArray
}

let sortedFragments = sortFragments(compactedShuffledFragments)

function dedupeFragments(sortedFragmentsArray) {
  let noDupes = []
  let idChecker = []
  for (let i of sortedFragmentsArray) {
    if (idChecker.includes(i['id'])) {
      console.log(`[DEDUPED] id ${i['id']}`)
    } else {
      idChecker.push(i['id'])
      noDupes.push(i)
    }
  }

  return noDupes
}

let dedupedFragments = dedupeFragments(sortedFragments)

function fillMissingFragments(sortedFragmentsArray) {
  let fullArray = []
  let minId = sortedFragmentsArray[0]['id']
  let maxId = sortedFragmentsArray[sortedFragmentsArray.length-1]['id']
  let diff = minId

//adjusts for gaps in the fragment ids; ensures that the loop iterates properly for matching.
  let adjuster = 0
  for (let i = 0; i <= maxId-diff; i++) {
    let item = sortedFragmentsArray[i-adjuster]
    if (item?.['id'] == i+diff) {
      fullArray.push(item)
      //console.log(`index is ${i-adjuster}, id is ${i+diff}`)
    } else {
      fullArray.push({ id: i+diff, text: "[...]" })
      adjuster++
      console.log(`[FILLED] id ${i+diff}`)
    }
  }
  return fullArray
}

let filledFragments = fillMissingFragments(dedupedFragments)

function assembleStory(sortedFragments) {
  let fullStory = ''
  let length = sortedFragments.length
  for (let i = 0; i < length; i++) {
    if (i < sortedFragments.length-1) {
    fullStory += sortedFragments[i]['text'] + '\n'
    } else {
      fullStory += sortedFragments[i]['text']
    }
  }
  return fullStory
}

